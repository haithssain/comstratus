---
import Base from '../../layouts/Base.astro';
import { ui, languages, type Lang } from '../../i18n/ui';

export function getStaticPaths() {
  return (Object.keys(languages) as Lang[]).map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = ui[lang];
---

<Base lang={lang} page="about" title={t.about.title} description={t.about.description}>
  <section class="section">
    <div class="container prose">
      <h1>{t.about.heading}</h1>
      {t.about.paragraphs.map((p) => <p>{p}</p>)}
    </div>
  </section>

  <section class="section soft">
    <div class="container">
      <h2>{t.about.valuesTitle}</h2>
      <div class="grid">
        {t.about.values.map((v) => (
          <article class="card">
            <h3>{v.title}</h3>
            <p>{v.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
</Base>
