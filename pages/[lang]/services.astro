---
import Base from '../../layouts/Base.astro';
import { ui, languages, type Lang } from '../../i18n/ui';

export function getStaticPaths() {
  return (Object.keys(languages) as Lang[]).map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = ui[lang];
---

<Base lang={lang} page="services" title={t.services.title} description={t.services.description}>
  <section class="section">
    <div class="container">
      <h1>{t.services.heading}</h1>
      <p class="lead">{t.services.intro}</p>
      <div class="grid" style="margin-top:2rem">
        {t.services.items.map((item) => (
          <article class="card">
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
</Base>
