---
import Base from '../../layouts/Base.astro';
import { ui, languages, type Lang } from '../../i18n/ui';

export function getStaticPaths() {
  return (Object.keys(languages) as Lang[]).map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = ui[lang];
---

<Base lang={lang} page="contact" title={t.contact.title} description={t.contact.description}>
  <section class="section">
    <div class="container prose">
      <h1>{t.contact.heading}</h1>
      <p class="lead">{t.contact.intro}</p>
      <p><strong>{t.contact.emailLabel} :</strong> <a href={`mailto:${t.contact.email}`}>{t.contact.email}</a></p>
      <div class="actions">
        <button class="btn" id="show-contact-form" type="button" aria-controls="contact-form" aria-expanded="false">
          {t.contact.button}
        </button>
      </div>
      <form
        id="contact-form"
        class="contact-form"
        data-sending={t.contact.sending}
        data-success={t.contact.success}
        data-send-error={t.contact.sendError}
        data-configuration-error={t.contact.configurationError}
        hidden
      >
        <div class="form-grid">
          <label>
            {t.contact.subjectLabel} *
            <select id="contact-subject" name="subject" required>
              <option value=""></option>
              {t.contact.subjectOptions.map((subject) => <option value={subject}>{subject}</option>)}
            </select>
          </label>
          <label>
            {t.contact.firstNameLabel} *
            <input name="firstName" type="text" maxlength="40" required />
          </label>
          <label>
            {t.contact.lastNameLabel} *
            <input name="lastName" type="text" maxlength="80" required />
          </label>
          <label>
            {t.contact.emailLabel} *
            <input name="email" type="email" maxlength="255" required />
          </label>
          <label>
            {t.contact.phoneLabel}
            <input name="phone" type="tel" maxlength="40" />
          </label>
          <label>
            {t.contact.companyLabel}
            <input name="company" type="text" maxlength="255" />
          </label>
          <label class="full-width">
            {t.contact.projectLabel} *
            <textarea name="project" rows="8" maxlength="10000" required></textarea>
          </label>
        </div>
        <div class="honeypot" aria-hidden="true">
          <label>Website<input name="website" type="text" tabindex="-1" autocomplete="off" /></label>
        </div>
        <div class="actions">
          <button class="btn" type="submit">{t.contact.send}</button>
        </div>
        <p id="contact-status" class="form-status" role="status" aria-live="polite"></p>
      </form>
    </div>
  </section>
</Base>

<script>
  const showButton = document.querySelector<HTMLButtonElement>('#show-contact-form');
  const form = document.querySelector<HTMLFormElement>('#contact-form');

  showButton?.addEventListener('click', () => {
    if (!form) return;
    form.hidden = false;
    showButton.setAttribute('aria-expanded', 'true');
    form.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();

    const status = document.querySelector<HTMLElement>('#contact-status');
    const sendButton = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const apiUrl = import.meta.env.PUBLIC_CONTACT_API_URL?.trim();
    if (!status || !sendButton) return;

    if (!apiUrl) {
      status.textContent = form.dataset.configurationError || '';
      status.dataset.state = 'error';
      return;
    }

    const data = new FormData(form);
    status.textContent = form.dataset.sending || '';
    status.dataset.state = 'pending';
    sendButton.disabled = true;

    try {
      const response = await fetch(apiUrl, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          locale: document.documentElement.lang,
          subject: data.get('subject'),
          firstName: data.get('firstName'),
          lastName: data.get('lastName'),
          email: data.get('email'),
          phone: data.get('phone'),
          company: data.get('company'),
          project: data.get('project'),
          website: data.get('website'),
        }),
      });

      if (!response.ok) throw new Error(`Contact request failed (${response.status})`);

      status.textContent = form.dataset.success || '';
      status.dataset.state = 'success';
      form.reset();
    } catch (error) {
      console.error('Unable to submit contact form:', error);
      status.textContent = form.dataset.sendError || '';
      status.dataset.state = 'error';
    } finally {
      sendButton.disabled = false;
    }
  });
</script>
