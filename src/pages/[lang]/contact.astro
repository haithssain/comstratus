---
import Base from '../../layouts/Base.astro';
import { ui, languages, type Lang } from '../../i18n/ui';

export function getStaticPaths() {
  return (Object.keys(languages) as Lang[]).map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = ui[lang];
---

<Base lang={lang} page="contact" title={t.contact.title} description={t.contact.description}>
  <section class="section">
    <div class="container prose">
      <h1>{t.contact.heading}</h1>
      <p class="lead">{t.contact.intro}</p>
      <p><strong>{t.contact.emailLabel} :</strong> <a href={`mailto:${t.contact.email}`}>{t.contact.email}</a></p>
      <div class="actions">
        <a class="btn" href={`mailto:${t.contact.email}`}>{t.contact.button}</a>
      </div>
      <p style="margin-top:2rem;color:var(--muted);font-size:0.9rem">{t.contact.note}</p>
    </div>
  </section>
</Base>
