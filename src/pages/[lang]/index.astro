---
import Base from '../../layouts/Base.astro';
import { ui, languages, type Lang } from '../../i18n/ui';

export function getStaticPaths() {
  return (Object.keys(languages) as Lang[]).map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = ui[lang];
---

<Base lang={lang} page="home" title={t.home.title} description={t.home.description}>
  <section class="hero">
    <div class="container hero-layout">
      <div class="hero-copy">
        <h1>{t.home.heroTitle}</h1>
        <p>{t.home.heroText}</p>
        <div class="actions">
          <a class="btn" href={`/${lang}/contact/`}>{t.home.ctaPrimary}</a>
          <a class="btn secondary" href={`/${lang}/services/`}>{t.home.ctaSecondary}</a>
        </div>
      </div>
      <img class="hero-clouds" src="/stratus-cloudscape.svg" alt="" aria-hidden="true" />
    </div>
  </section>

  <section class="section soft">
    <div class="container">
      <h2>{t.home.servicesTitle}</h2>
      <div class="grid">
        {t.services.items.map((item) => (
          <article class="card">
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section cta-band">
    <div class="container">
      <h2>{t.home.ctaTitle}</h2>
      <p class="lead" style="margin-inline:auto">{t.home.ctaText}</p>
      <div class="actions">
        <a class="btn" href={`/${lang}/contact/`}>{t.nav.contact}</a>
      </div>
    </div>
  </section>
</Base>
