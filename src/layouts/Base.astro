---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import { languages, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  page: 'home' | 'services' | 'about' | 'contact';
  title: string;
  description: string;
}
const { lang, page, title, description } = Astro.props;

// Liens hreflang vers les autres langues (utile pour le référencement)
const pathSuffix = Astro.url.pathname.replace(`/${lang}/`, '/');
const alternates = (Object.keys(languages) as Lang[]).map((l) => ({
  lang: l,
  href: new URL(`/${l}${pathSuffix}`, Astro.site).href,
}));
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
  </head>
  <body>
    <Header lang={lang} page={page} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
