---
import Wordmark from './Wordmark.astro';
import { ui, languages, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  page: 'home' | 'services' | 'about' | 'contact';
}
const { lang, page } = Astro.props;
const t = ui[lang];

const links = [
  { key: 'home', href: `/${lang}/`, label: t.nav.home },
  { key: 'services', href: `/${lang}/services/`, label: t.nav.services },
  { key: 'about', href: `/${lang}/about/`, label: t.nav.about },
  { key: 'contact', href: `/${lang}/contact/`, label: t.nav.contact },
];

// Même page, autre langue
const pathSuffix = Astro.url.pathname.replace(`/${lang}/`, '/');
const otherLangs = (Object.keys(languages) as Lang[]).filter((l) => l !== lang);
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href={`/${lang}/`} aria-label={t.siteName}>
      <Wordmark />
    </a>
    <nav aria-label="Navigation principale">
      <ul>
        {links.map((l) => (
          <li><a href={l.href} aria-current={l.key === page ? 'page' : undefined}>{l.label}</a></li>
        ))}
      </ul>
    </nav>
    <div class="langs" aria-label={t.langLabel}>
      {otherLangs.map((l) => (
        <a href={`/${l}${pathSuffix}`} hreflang={l} lang={l}>{l.toUpperCase()}</a>
      ))}
    </div>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--border);
    background: #fff;
    position: sticky;
    top: 0;
    z-index: 10;
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding-block: 0.9rem;
  }
  .brand { text-decoration: none; }
  nav ul {
    display: flex;
    gap: 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
  }
  nav a {
    text-decoration: none;
    color: var(--text);
    font-weight: 500;
    padding-block: 0.3rem;
    border-bottom: 2px solid transparent;
  }
  nav a:hover { border-bottom-color: var(--border); }
  nav a[aria-current='page'] { border-bottom-color: var(--primary); color: var(--primary); }
  .langs a {
    text-decoration: none;
    font-weight: 600;
    font-size: 0.85rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0.3rem 0.6rem;
    color: var(--text);
  }
  .langs a:hover { border-color: var(--primary); color: var(--primary); }
</style>
