{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start Astro dev server",
            "type": "npm",
            "script": "dev",
            "isBackground": true,
            "problemMatcher": {
                "owner": "astro",
                "pattern": {
                    "regexp": "^$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".*",
                    "endsPattern": ".*ready in.*"
                }
            }
        }
    ]
}
